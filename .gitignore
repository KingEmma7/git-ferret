# git-wombat local config. The shipped default documents the schema; this is
# the personal file and stays untracked.
.git-wombat.toml

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Isolated workspaces
.worktrees/

# NOTE: .git/ is deliberately NOT ignored. git-wombat analyses git
# repositories, so treating it as ordinary build output would be wrong, and the
# directory is already tracked implicitly as the repository itself.
