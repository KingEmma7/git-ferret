#!/usr/bin/env bash
# Format and lint the Python files in this commit, then re-stage them.
#
# Mirrors lint-staged without adding a Node toolchain: only staged files are
# touched, so a commit never reformats unrelated work.

set -euo pipefail
source "$(dirname "$0")/common.sh"

run_global_hook pre-commit "$@"

files=()
while IFS= read -r file; do
    [ -n "$file" ] && files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')

[ "${#files[@]}" -eq 0 ] && exit 0

python=$(python_bin)
"$python" -m ruff format "${files[@]}"
"$python" -m ruff check --fix "${files[@]}"
git add -- "${files[@]}"
