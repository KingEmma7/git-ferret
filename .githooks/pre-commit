# Format and lint the Python files in this commit, then re-stage them.
#
# Mirrors lint-staged without adding a Node toolchain: only staged files are
# touched. A file with unstaged changes is refused rather than staged whole,
# so a commit never swallows work the user did not stage.

set -euo pipefail
source "$(dirname "$0")/common.sh"

run_global_hook pre-commit "$@"

files=()
while IFS= read -r -d '' file; do
    files+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.py')

[ "${#files[@]}" -eq 0 ] && exit 0

partial=()
for file in "${files[@]}"; do
    if ! git diff --quiet -- "$file"; then
        partial+=("$file")
    fi
done

if [ "${#partial[@]}" -gt 0 ]; then
    printf 'pre-commit: refusing to touch files with unstaged changes:\n' >&2
    printf '  %s\n' "${partial[@]}" >&2
    printf 'Stage or stash them, then commit again.\n' >&2
    exit 1
fi

python=$(python_bin)
"$python" -m ruff format -- "${files[@]}"
"$python" -m ruff check --fix -- "${files[@]}"
git add -- "${files[@]}"
