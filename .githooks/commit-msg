# Check the subject against the project's Conventional Commits rules.

set -euo pipefail
source "$(dirname "$0")/common.sh"

run_global_hook commit-msg "$@"

python=$(python_bin)
comment_char=$(git config --get core.commentChar 2>/dev/null || true)
case "$comment_char" in
    "" | auto) comment_char="#" ;;
esac
exec "$python" scripts/check_commit_msg.py "$1" "$comment_char"
